# ─── CockroachDB ─────────────────────────────────────────────────────────────
# From: CockroachDB Cloud → Cluster → Connect → Connection string
COCKROACHDB_CONNECTION_STRING=postgresql://[user]:[password]@[host].cockroachlabs.cloud:26257/agentguard?sslmode=verify-full

# MCP Server URL is always the same for everyone — auth varies per user.
# Create a service account: Cloud Console → Access Management → Service Accounts → + New
# COCKROACHDB_CLUSTER_ID: from Overview page URL → /cluster/{id}/overview (optional scope)
COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACHDB_MCP_API_KEY=
COCKROACHDB_CLUSTER_ID=

# ─── Gemini ──────────────────────────────────────────────────────────────────
# From: aistudio.google.com → API keys
# Models used: text-embedding-004 (768-dim vectors), gemini-2.0-flash (LLM)
GOOGLE_API_KEY=

# ─── Supabase (backend — never expose service_role to frontend) ───────────────
# From: Supabase project → Settings → API
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase (frontend — VITE_ prefix required for Vite exposure) ────────────
VITE_SUPABASE_URL=https://[project].supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
